<% if (page.tag) { %>
<article class="tag-page">
    <header class="page-hero">
        <p class="page-eyebrow">Topic</p>
        <h1 class="page-title"><%= page.tag %></h1>
        <p class="page-desc"><%= page.posts.length %> article<%= page.posts.length > 1 ? 's' : '' %> filed under this topic.</p>
    </header>

    <section class="tag-posts-list" aria-label="Tagged posts">
        <% page.posts.each(function(post){ %>
        <a href="<%- url_for(post.path) %>" class="archive-item">
            <span class="archive-date"><%= date(post.date, 'YYYY-MM-DD') %></span>
            <span class="archive-item-title"><%= post.title || 'Untitled' %></span>
            <span class="text-link">Read <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <% }) %>
    </section>

    <% if (page.total > 1){ %>
    <nav class="page-nav">
        <%- paginator({ prev_text: '&laquo; Prev', next_text: 'Next &raquo;' }) %>
    </nav>
    <% } %>
</article>

<% } else { %>
<article class="tag-page">
    <header class="page-hero page-hero-split">
        <div>
            <p class="page-eyebrow">Tags</p>
            <h1 class="page-title">Topic Index</h1>
            <p class="page-desc">A compact map of writing themes and recurring ideas.</p>
        </div>
        <div class="page-hero-stats" aria-label="Tags overview">
            <div>
                <span>Total</span>
                <strong><%= site.tags.length %></strong>
            </div>
        </div>
    </header>

    <% if (site.tags.length) { %>
    <section class="tag-cloud" aria-label="All tags">
        <% site.tags.sort('name').each(function(tag){ %>
        <a href="<%- url_for(tag.path) %>" class="tag-item">
            <span class="tag-name"><%= tag.name %></span>
            <span class="tag-count"><%= tag.posts.length %></span>
        </a>
        <% }) %>
    </section>
    <% } else { %>
    <div class="empty-state">
        <i class="fas fa-tags" aria-hidden="true"></i>
        <p>No tags yet.</p>
    </div>
    <% } %>
</article>
<% } %>
