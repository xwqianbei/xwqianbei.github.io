<%
var lifeData = site.data.life || {};
var interestTypes = lifeData.interestTypes || [];
var lifeRecords = lifeData.records || [];

var recordCountByKind = {};
lifeRecords.forEach(function(item) {
    recordCountByKind[item.kind] = (recordCountByKind[item.kind] || 0) + 1;
});

var filters = [{ key: 'all', label: '全部', icon: 'fa-border-all', tone: 'All', count: lifeRecords.length }].concat(interestTypes.map(function(item) {
    return {
        key: item.key,
        label: item.label,
        icon: item.icon,
        tone: item.tone,
        count: recordCountByKind[item.key] || 0
    };
}));

var yearCount = {};
lifeRecords.forEach(function(item) {
    yearCount[item.year] = true;
});

var initialRecord = lifeRecords[0] || {
    kind: 'life',
    label: '生活',
    icon: 'fa-compass',
    date: '待记录',
    year: String(new Date().getFullYear()),
    title: '生活记录待补充',
    place: '下一段值得保存的时间',
    focus: '这里会保留日期、地点、作品、照片和当时的心情。',
    mood: '空白位置',
    stat: '0 records',
    cover: '',
    details: [],
    tags: ['待补充']
};
%>

<article class="life-page">
    <header class="life-hero">
        <div class="life-hero-copy">
            <p class="life-kicker">Life ledger</p>
            <h1 class="life-title">把远方、旋律、影像和阅读过的日子留下来</h1>
            <p class="life-intro">
                旅行、摄影、音乐、影视和书籍会在这里按时间沉淀成个人生活档案。每条记录保留日期、地点、作品、标签和当时的情绪，适合长期补充和回看。
            </p>
        </div>
        <div class="life-hero-stats" aria-label="生活记录概览">
            <div>
                <span>Records</span>
                <strong><%= lifeRecords.length %></strong>
            </div>
            <div>
                <span>Years</span>
                <strong><%= Object.keys(yearCount).length %></strong>
            </div>
            <div>
                <span>Interests</span>
                <strong><%= interestTypes.length %></strong>
            </div>
        </div>
    </header>

    <section class="life-ledger" data-life-ledger>
        <aside class="life-focus" aria-live="polite">
            <div class="life-focus-media">
                <img src="<%- initialRecord.cover ? url_for(initialRecord.cover) : '' %>" alt="<%= initialRecord.title %>" data-focus-cover<% if (!initialRecord.cover) { %> hidden<% } %> />
                <div class="life-focus-art" data-focus-art<% if (initialRecord.cover) { %> hidden<% } %>>
                    <i class="fas <%= initialRecord.icon %>" aria-hidden="true" data-focus-art-icon></i>
                    <span data-focus-art-kind><%= initialRecord.label %></span>
                </div>
            </div>
            <div class="life-focus-body">
                <div class="life-focus-meta">
                    <span data-focus-kind><%= initialRecord.label %></span>
                    <span data-focus-date><%= initialRecord.date %></span>
                </div>
                <h2 data-focus-title><%= initialRecord.title %></h2>
                <p class="life-focus-place"><i class="fas fa-location-dot" aria-hidden="true"></i> <span data-focus-place><%= initialRecord.place %></span></p>
                <p class="life-focus-text" data-focus-text><%= initialRecord.focus %></p>
                <div class="life-focus-mood">
                    <span>Memory</span>
                    <strong data-focus-mood><%= initialRecord.mood %></strong>
                </div>
                <div class="life-focus-tags" data-focus-tags aria-label="当前记录标签">
                    <% initialRecord.tags.forEach(function(tag) { %>
                    <span><%= tag %></span>
                    <% }); %>
                </div>
            </div>
        </aside>

        <div class="life-stream">
            <section class="life-filter-panel" aria-label="兴趣索引">
                <div class="life-filter-head">
                    <span>Archive</span>
                    <strong><span data-life-visible-count><%= lifeRecords.length %></span> / <%= lifeRecords.length %></strong>
                </div>
                <div class="life-filter-list" role="list">
                    <% filters.forEach(function(filter, index) { %>
                    <button class="life-filter<% if (index === 0) { %> active<% } %>" type="button" data-life-filter="<%= filter.key %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>">
                        <i class="fas <%= filter.icon %>" aria-hidden="true"></i>
                        <span class="life-filter-label"><%= filter.label %></span>
                        <span class="life-filter-count"><%= filter.count %></span>
                    </button>
                    <% }); %>
                </div>
            </section>

            <section class="life-interest-strip" aria-label="兴趣维度">
                <% interestTypes.forEach(function(item) { %>
                <div class="life-interest-item">
                    <i class="fas <%= item.icon %>" aria-hidden="true"></i>
                    <span><%= item.label %></span>
                    <small><%= item.tone %></small>
                </div>
                <% }); %>
            </section>

            <section class="life-timeline" aria-label="生活时间线">
                <% lifeRecords.forEach(function(item, index) { %>
                <article
                    class="life-entry<% if (index === 0) { %> is-active<% } %>"
                    data-life-entry
                    data-life-kind="<%= item.kind %>"
                    data-life-id="<%= item.id %>"
                    data-title="<%= item.title %>"
                    data-kind-label="<%= item.label %>"
                    data-date="<%= item.date %>"
                    data-place="<%= item.place %>"
                    data-focus="<%= item.focus %>"
                    data-mood="<%= item.mood %>"
                    data-stat="<%= item.stat %>"
                    data-icon="<%= item.icon %>"
                    data-cover="<%- item.cover ? url_for(item.cover) : '' %>"
                    data-tags="<%= item.tags.join('|') %>"
                    data-details="<%= item.details.join('|') %>"
                    data-has-content="<%= item.content ? 'true' : 'false' %>"
                >
                    <button class="life-entry-card" type="button" data-life-select aria-pressed="<%= index === 0 ? 'true' : 'false' %>">
                        <span class="life-entry-node">
                            <i class="fas <%= item.icon %>" aria-hidden="true"></i>
                        </span>
                        <span class="life-entry-content">
                            <span class="life-entry-top">
                                <span class="life-entry-date"><%= item.date %></span>
                                <span class="life-entry-kind"><%= item.label %></span>
                            </span>
                            <strong><%= item.title %></strong>
                            <span class="life-entry-place"><i class="fas fa-location-dot" aria-hidden="true"></i> <%= item.place %></span>
                            <span class="life-entry-desc"><%= item.focus %></span>
                            <span class="life-entry-tags" aria-label="标签">
                                <% item.tags.forEach(function(tag) { %>
                                <span><%= tag %></span>
                                <% }); %>
                            </span>
                            <% if (item.content) { %>
                            <span class="life-entry-actions">
                                <span class="life-detail-trigger" data-life-detail-open="<%= item.id %>">
                                    <i class="fas fa-book-open" aria-hidden="true"></i>
                                    View detailed note
                                </span>
                            </span>
                            <% } %>
                        </span>
                    </button>
                    <div class="life-entry-details">
                        <div class="life-entry-stat">
                            <span><%= item.stat %></span>
                            <strong><%= item.mood %></strong>
                        </div>
                        <ul>
                            <% item.details.forEach(function(detail) { %>
                            <li><%= detail %></li>
                            <% }); %>
                        </ul>
                    </div>
                </article>
                <% }); %>

                <div class="life-empty-filter" hidden>
                    <i class="fas fa-feather-pointed" aria-hidden="true"></i>
                    <p>这个分类还没有公开记录。</p>
                </div>
            </section>
        </div>
    </section>

    <% lifeRecords.forEach(function(item) { if (item.content) { %>
    <section class="life-detail-modal" data-life-detail-modal="<%= item.id %>" aria-hidden="true">
        <div class="life-detail-backdrop" data-life-detail-close></div>
        <article class="life-detail-panel" role="dialog" aria-modal="true" aria-labelledby="life-detail-title-<%= item.id %>">
            <button class="life-detail-close" type="button" data-life-detail-close aria-label="Close detail">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
            <header class="life-detail-header">
                <p class="life-kicker"><%= item.label %> · <%= item.date %></p>
                <h2 id="life-detail-title-<%= item.id %>"><%= item.title %></h2>
                <% if (item.place) { %>
                <p><i class="fas fa-location-dot" aria-hidden="true"></i> <%= item.place %></p>
                <% } %>
            </header>
            <div class="life-detail-content post-content">
                <%- markdown(item.content || '') %>
            </div>
        </article>
    </section>
    <% } }); %>
</article>

<script>
    (function() {
        const root = document.querySelector('[data-life-ledger]');
        if (!root) return;

        const filters = Array.from(root.querySelectorAll('[data-life-filter]'));
        const entries = Array.from(root.querySelectorAll('[data-life-entry]'));
        const empty = root.querySelector('.life-empty-filter');
        const visibleCount = root.querySelector('[data-life-visible-count]');
        const focusCover = root.querySelector('[data-focus-cover]');
        const focusArt = root.querySelector('[data-focus-art]');
        const focusArtIcon = root.querySelector('[data-focus-art-icon]');
        const focusArtKind = root.querySelector('[data-focus-art-kind]');
        const focusTags = root.querySelector('[data-focus-tags]');
        const detailModals = Array.from(document.querySelectorAll('[data-life-detail-modal]'));

        function setText(selector, value) {
            const target = root.querySelector(selector);
            if (target) target.textContent = value || '';
        }

        function fillInlineList(container, values) {
            if (!container) return;
            container.innerHTML = '';
            values.filter(Boolean).forEach(function(value) {
                const item = document.createElement('span');
                item.textContent = value;
                container.appendChild(item);
            });
        }

        function updateFocus(entry) {
            const hasCover = Boolean(entry.dataset.cover);
            if (focusCover) {
                focusCover.hidden = !hasCover;
                if (hasCover) {
                    focusCover.src = entry.dataset.cover;
                    focusCover.alt = entry.dataset.title || '';
                }
            }
            if (focusArt) focusArt.hidden = hasCover;
            if (focusArtIcon) focusArtIcon.className = 'fas ' + (entry.dataset.icon || 'fa-compass');
            if (focusArtKind) focusArtKind.textContent = entry.dataset.kindLabel || '';

            setText('[data-focus-kind]', entry.dataset.kindLabel);
            setText('[data-focus-date]', entry.dataset.date);
            setText('[data-focus-title]', entry.dataset.title);
            setText('[data-focus-place]', entry.dataset.place);
            setText('[data-focus-text]', entry.dataset.focus);
            setText('[data-focus-mood]', entry.dataset.mood);
            fillInlineList(focusTags, (entry.dataset.tags || '').split('|'));
        }

        function updateEmptyFocus(label) {
            if (focusCover) focusCover.hidden = true;
            if (focusArt) focusArt.hidden = false;
            if (focusArtIcon) focusArtIcon.className = 'fas fa-feather-pointed';
            if (focusArtKind) focusArtKind.textContent = label || '生活';

            setText('[data-focus-kind]', label || '生活');
            setText('[data-focus-date]', '待记录');
            setText('[data-focus-title]', (label || '生活') + '记录待补充');
            setText('[data-focus-place]', '下一段值得保存的时间');
            setText('[data-focus-text]', '这里会保留日期、地点、作品、照片和当时的心情。');
            setText('[data-focus-mood]', '空白位置');
            fillInlineList(focusTags, ['待补充']);
        }

        function selectEntry(entry) {
            entries.forEach(function(item) {
                const active = item === entry;
                item.classList.toggle('is-active', active);
                const button = item.querySelector('[data-life-select]');
                if (button) button.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
            updateFocus(entry);
        }

        function applyFilter(kind) {
            let shown = [];
            entries.forEach(function(entry) {
                const visible = kind === 'all' || entry.dataset.lifeKind === kind;
                entry.hidden = !visible;
                if (visible) shown.push(entry);
            });

            if (visibleCount) visibleCount.textContent = shown.length;
            if (empty) empty.hidden = shown.length !== 0;

            filters.forEach(function(button) {
                const active = button.dataset.lifeFilter === kind;
                button.classList.toggle('active', active);
                button.setAttribute('aria-pressed', active ? 'true' : 'false');
            });

            if (shown.length) {
                selectEntry(shown[0]);
                return;
            }

            const activeFilter = filters.find(function(button) {
                return button.dataset.lifeFilter === kind;
            });
            const label = activeFilter ? activeFilter.querySelector('.life-filter-label').textContent : '';
            entries.forEach(function(entry) {
                entry.classList.remove('is-active');
                const button = entry.querySelector('[data-life-select]');
                if (button) button.setAttribute('aria-pressed', 'false');
            });
            updateEmptyFocus(label);
        }

        filters.forEach(function(button) {
            button.addEventListener('click', function() {
                applyFilter(button.dataset.lifeFilter);
            });
        });

        entries.forEach(function(entry) {
            const button = entry.querySelector('[data-life-select]');
            if (button) {
                button.addEventListener('click', function(event) {
                    const detailTrigger = event.target.closest('[data-life-detail-open]');
                    if (detailTrigger) {
                        event.preventDefault();
                        event.stopPropagation();
                        openDetail(detailTrigger.dataset.lifeDetailOpen);
                        return;
                    }
                    selectEntry(entry);
                });
            }
        });

        document.querySelectorAll('[data-life-detail-open]').forEach(function(trigger) {
            trigger.addEventListener('click', function(event) {
                event.preventDefault();
                event.stopPropagation();
                openDetail(trigger.dataset.lifeDetailOpen);
            });
        });

        document.querySelectorAll('[data-life-detail-close]').forEach(function(closeButton) {
            closeButton.addEventListener('click', closeDetail);
        });

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') closeDetail();
        });

        function openDetail(id) {
            const modal = detailModals.find(function(item) {
                return item.dataset.lifeDetailModal === id;
            });
            if (!modal) return;
            modal.classList.add('open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('life-detail-open');
        }

        function closeDetail() {
            detailModals.forEach(function(modal) {
                modal.classList.remove('open');
                modal.setAttribute('aria-hidden', 'true');
            });
            document.body.classList.remove('life-detail-open');
        }
    })();
</script>
