<%
var projects = [
    {
        tag: 'LLM · Post-Training',
        title: 'Life-Service LLM Post-Training',
        desc: 'Domain foundation model work across continual pre-training, instruction data recipes, evaluation design, and scaling experiments for life-service scenarios.',
        image: '/images/self/life_photo.jpg',
        href: 'https://github.com/xwqianbei',
        stats: ['LongCat-8B', '18B scaling', 'Domain eval']
    },
    {
        tag: 'Agent · Search',
        title: 'AI Search Agent',
        desc: 'A planning-execution search agent focused on function calling, retrieval decisions, bad-case loops, and end-to-end model training.',
        image: '/images/self/life_photo.jpg',
        href: 'https://github.com/xwqianbei',
        stats: ['Planning', 'Function call', 'Retrieval']
    },
    {
        tag: 'Research · MARL',
        title: 'Multi-Agent Role Assignment',
        desc: 'LLM-guided role assignment and coordination strategies for improving heterogeneous-team stability in multi-agent reinforcement learning.',
        image: '/images/self/life_photo.jpg',
        href: 'https://github.com/xwqianbei',
        stats: ['MARL', 'Coordination', 'PAKDD']
    }
];
%>

<article class="projects-page">
    <header class="page-hero page-hero-split">
        <div>
            <p class="page-eyebrow">Works</p>
            <h1 class="page-title">Selected Systems</h1>
            <p class="page-desc">A concise portfolio of research, engineering, and product-minded work, organized for quick scanning and deeper follow-up.</p>
        </div>
        <a href="https://github.com/xwqianbei" class="hero-inline-link" target="_blank" rel="noopener">
            <i class="fab fa-github" aria-hidden="true"></i>
            GitHub
        </a>
    </header>

    <section class="project-grid" aria-label="Project list">
        <% projects.forEach(function(project) { %>
        <a href="<%= project.href %>" class="project-card" target="_blank" rel="noopener">
            <div class="project-card-media">
                <img src="<%- url_for(project.image) %>" alt="<%= project.title %>" />
                <span><%= project.tag %></span>
            </div>
            <div class="project-card-body">
                <h2><%= project.title %></h2>
                <p><%= project.desc %></p>
                <div class="project-card-tags" aria-label="Project keywords">
                    <% project.stats.forEach(function(stat) { %>
                    <span><%= stat %></span>
                    <% }); %>
                </div>
                <span class="text-link">View work <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </div>
        </a>
        <% }); %>
    </section>

    <%- page.content %>
</article>
