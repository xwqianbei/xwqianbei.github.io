<div class="portfolio-header">
    <h1 class="page-title">系统性的博客</h1>
    <p class="page-desc">做过的事情，要记下来，时时去看，复盘短板，发扬优点，温故而知新，且不枉人间一趟</p>
</div>

<% if (page.posts && page.posts.length > 0) { %>

<div class="portfolio-list">
<% page.posts.each(function(post){ %>
    <a href="<%- url_for(post.path) %>" class="portfolio-card">
        <% var coverImg = post.cover || post.image || '/images/self/life_photo.jpg'; %>
        <img src="<%- url_for(coverImg) %>" alt="<%= post.title %>" class="portfolio-card-img" />
        <div class="portfolio-card-content">
            <div class="portfolio-card-tag">
                <% if (post.tags && post.tags.length) { %>
                    <%= post.tags.toArray()[0].name %>
                <% } else if (post.categories && post.categories.length) { %>
                    <%= post.categories.toArray()[0].name %>
                <% } else { %>
                    Article
                <% } %>
            </div>
            <h2 class="portfolio-card-title"><%= post.title || "Untitled" %></h2>
            <div class="portfolio-card-desc">
                <%= strip_html(post.excerpt || post.content).substring(0, 150) %>
            </div>
            <span class="portfolio-card-btn">文章详情</span>
        </div>
    </a>
<% }); %>
</div>

<% if (page.total > 1){ %>
<nav class="page-nav">
    <%- paginator({ prev_text: '&laquo; Prev', next_text: 'Next &raquo;' }) %>
</nav>
<% } %>

<% } else { %>
<div class="empty-state">
    <i class="fas fa-feather-pointed"></i>
    <p>No posts yet. Stay tuned!</p>
</div>
<% } %>