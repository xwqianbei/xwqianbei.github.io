<%
function getPostTag(post) {
    if (post.tags && post.tags.length) return post.tags.toArray()[0].name;
    if (post.categories && post.categories.length) return post.categories.toArray()[0].name;
    return 'Article';
}

var totalPosts = site.posts ? site.posts.length : 0;
var visiblePosts = page.posts ? page.posts.length : 0;
%>

<article class="writing-page">
    <header class="page-hero page-hero-split">
        <div>
            <p class="page-eyebrow">Writing</p>
            <h1 class="page-title">Field Notes</h1>
            <p class="page-desc">Technical notes, research reflections, product thinking, and life observations kept in a clean reading flow.</p>
        </div>
        <div class="page-hero-stats" aria-label="Writing overview">
            <div>
                <span>Total</span>
                <strong><%= totalPosts %></strong>
            </div>
            <div>
                <span>Shown</span>
                <strong><%= visiblePosts %></strong>
            </div>
        </div>
    </header>

    <% if (page.posts && page.posts.length > 0) { %>
    <section class="writing-list" aria-label="Writing list">
        <% page.posts.each(function(post, index){ 
            var coverImg = post.cover || post.image || '/images/self/life_photo.jpg';
            var primaryTag = getPostTag(post);
        %>
        <a href="<%- url_for(post.path) %>" class="writing-card">
            <div class="writing-card-media">
                <img src="<%- url_for(coverImg) %>" alt="<%= post.title || 'Article cover' %>" />
                <span><%= ('0' + (index + 1)).slice(-2) %></span>
            </div>
            <div class="writing-card-body">
                <div class="writing-card-meta">
                    <span><i class="far fa-calendar" aria-hidden="true"></i> <%= date(post.date, 'MMM DD, YYYY') %></span>
                    <span><%= primaryTag %></span>
                </div>
                <h2><%= post.title || 'Untitled' %></h2>
                <p><%= strip_html(post.excerpt || post.content).substring(0, 170) %></p>
                <span class="text-link">Read note <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </div>
        </a>
        <% }); %>
    </section>

    <% if (page.total > 1){ %>
    <nav class="page-nav">
        <%- paginator({ prev_text: '&laquo; Prev', next_text: 'Next &raquo;' }) %>
    </nav>
    <% } %>

    <% } else { %>
    <div class="empty-state">
        <i class="fas fa-feather-pointed" aria-hidden="true"></i>
        <p>No posts yet. Stay tuned.</p>
    </div>
    <% } %>
</article>
