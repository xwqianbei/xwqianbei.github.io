<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <a href="<%- url_for('/') %>" class="footer-logo"><%= config.author %></a>
            <p class="footer-tagline"><%= config.description %></p>
        </div>
        <div class="footer-links">
            <div class="footer-col">
                <h4>Navigation</h4>
                <% for (var i in theme.menu){ %>
                <a href="<%- url_for(theme.menu[i]) %>"><%= i %></a>
                <% } %>
            </div>
            <div class="footer-col">
                <h4>Connect</h4>
                <% if (theme.social && theme.social.github) { %>
                <a href="<%= theme.social.github %>" target="_blank" rel="noopener"><i class="fab fa-github" aria-hidden="true"></i> GitHub</a>
                <% } %>
                <% if (theme.social && theme.social.email) { %>
                <a href="mailto:<%= theme.social.email %>"><i class="fas fa-envelope" aria-hidden="true"></i> Email</a>
                <% } %>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; <%= date(new Date(), 'YYYY') %> <%= config.author %>. Crafted with <i class="fas fa-heart" aria-hidden="true"></i></p>
        </div>
    </div>
</footer>
