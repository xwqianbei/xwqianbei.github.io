<%
function normalizeNavPath(path) {
    var value = String(path || '/');
    value = value.replace(/^\/?/, '/').replace(/index\.html$/, '');
    if (value.length > 1 && value.slice(-1) !== '/') value += '/';
    return value;
}

var currentNavPath = is_home() ? '/' : normalizeNavPath(page.path || page.current_url || '');

function isNavActive(target) {
    var targetPath = normalizeNavPath(target);
    if (targetPath === '/') return is_home();
    if (targetPath === '/archives/' && /^\/\d{4}\//.test(currentNavPath)) return true;
    return currentNavPath.indexOf(targetPath) === 0;
}

var navMeta = {
    '首页': { icon: 'fa-house-chimney', tone: 'Home' },
    '文字': { icon: 'fa-pen-nib', tone: 'Writing' },
    '作品': { icon: 'fa-layer-group', tone: 'Works' },
    '生活': { icon: 'fa-compass', tone: 'Life' },
    '关于': { icon: 'fa-user', tone: 'About' }
};

function getNavMeta(key) {
    return navMeta[key] || { icon: 'fa-circle', tone: key };
}
%>
<!DOCTYPE html>
<html lang="<%- config.language %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page.title ? page.title + ' — ' + config.title : config.title %></title>
    <meta name="description" content="<%= config.description %>">
    <meta name="author" content="<%= config.author %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700;900&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <%- css('css/style') %>
    <% if (is_home()) { %>
    <%- css('css/hero') %>
    <% } %>
</head>

<body<% if (is_home()) { %> class="hero-page"<% } %>>
    <% if (is_home()) { %>
    <%- body %>
    <% } else { %>
    <nav class="main-nav" id="mainNav">
        <div class="nav-inner">
            <a href="<%- url_for('/') %>" class="logo" aria-label="返回首页">
                <span class="logo-mark">
                    <img src="<%- url_for(theme.avatar || '/images/icons/main.jpg') %>" alt="" />
                </span>
                <span class="logo-copy">
                    <strong><%= config.author %></strong>
                    <small>Personal archive</small>
                </span>
            </a>
            <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-links" id="navLinks">
                <% var menuKeys = Object.keys(theme.menu); %>
                <% menuKeys.forEach(function(key) { 
                    var active = isNavActive(theme.menu[key]);
                    var meta = getNavMeta(key);
                %>
                <li>
                    <a href="<%- url_for(theme.menu[key]) %>" class="nav-link<% if (active) { %> active<% } %>"<% if (active) { %> aria-current="page"<% } %>>
                        <i class="fas <%= meta.icon %>" aria-hidden="true"></i>
                        <span class="nav-link-label"><%= key %></span>
                        <span class="nav-link-tone"><%= meta.tone %></span>
                    </a>
                </li>
                <% }); %>
            </ul>
        </div>
    </nav>

    <main class="main-content">
        <%- body %>
    </main>

    <%- partial('_partial/footer') %>
    <% } %>

    <% if (!is_home()) { %>
    <script>
        const toggle = document.getElementById('mobileToggle');
        const navLinks = document.getElementById('navLinks');
        const nav = document.getElementById('mainNav');

        function setMenu(open) {
            navLinks.classList.toggle('open', open);
            toggle.classList.toggle('active', open);
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        toggle.addEventListener('click', () => {
            setMenu(!navLinks.classList.contains('open'));
        });

        navLinks.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
                setMenu(false);
            });
        });

        function syncNavState() {
            if (window.pageYOffset > 60) {
                nav.classList.add('scrolled');
                return;
            }
            nav.classList.remove('scrolled');
        }

        window.addEventListener('scroll', syncNavState, { passive: true });
        syncNavState();
    </script>
    <% } %>
</body>

</html>
