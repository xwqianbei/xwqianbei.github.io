<!-- Full-Screen Hero -->
<section class="hero-home" id="heroHome">
    <!-- Background Photo -->
    <div class="hero-bg"></div>
    <!-- Gradient Overlay -->
    <div class="hero-overlay"></div>
    <!-- Atmospheric Glow -->
    <div class="hero-glow"></div>
    <div class="hero-glow-secondary"></div>

    <!-- Floating Particles -->
    <div class="hero-particles">
        <div class="particle" style="left:10%;top:20%;animation-delay:0s;animation-duration:7s;"></div>
        <div class="particle" style="left:25%;top:60%;animation-delay:1.5s;animation-duration:9s;"></div>
        <div class="particle" style="left:45%;top:15%;animation-delay:3s;animation-duration:6s;"></div>
        <div class="particle" style="left:65%;top:70%;animation-delay:0.5s;animation-duration:8s;"></div>
        <div class="particle" style="left:80%;top:30%;animation-delay:2s;animation-duration:10s;"></div>
        <div class="particle" style="left:90%;top:55%;animation-delay:4s;animation-duration:7s;"></div>
        <div class="particle" style="left:15%;top:80%;animation-delay:2.5s;animation-duration:11s;"></div>
        <div class="particle" style="left:55%;top:45%;animation-delay:1s;animation-duration:8s;"></div>
    </div>

    <!-- Hero Content -->
    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-home-greeting">
                你好<span class="wave">👋</span>，
                <br>
                我是<span class="hero-home-name"><%= config.author %></span>
            </h1>
            <p class="hero-home-subtitle"><%= config.subtitle %></p>
            <p class="hero-home-desc"><%= config.description %></p>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator" aria-hidden="true">
        <div class="scroll-mouse">
            <div class="scroll-dot"></div>
        </div>
        <span class="scroll-text">SCROLL</span>
    </div>
</section>