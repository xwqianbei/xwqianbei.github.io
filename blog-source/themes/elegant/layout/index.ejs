<section class="hero-fullscreen" id="heroSection" aria-label="个人主页">
    <div class="hero-bg">
        <div class="hero-bg-image"></div>
        <div class="hero-bg-overlay"></div>
    </div>

    <nav class="hero-nav" id="heroNav">
        <div class="hero-nav-inner">
            <a href="<%- url_for('/') %>" class="hero-brand">
                <img src="<%= theme.avatar || '/images/icons/main.jpg' %>" alt="<%= config.author %>" class="hero-avatar" />
                <span><%= config.author %></span>
            </a>
            <ul class="hero-nav-links" id="heroNavLinks">
                <% var menuKeys = Object.keys(theme.menu); %>
                <% menuKeys.forEach(function(key, index) { %>
                <li><a href="<%- url_for(theme.menu[key]) %>" class="hero-nav-link<% if (key === 'Home') { %> active<% } %>"><%= key %></a></li>
                <% if (index < menuKeys.length - 1) { %>
                <li class="nav-separator">/</li>
                <% } %>
                <% }); %>
            </ul>
            <button class="hero-mobile-toggle" id="heroMobileToggle" aria-label="Toggle menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <div class="hero-content">
        <div class="hero-text">
            <p class="hero-kicker">Xiong Wei · LLM Algorithm Engineer</p>
            <h1 class="hero-title"><%= config.author %></h1>
            <p class="hero-subtitle"><%= config.subtitle %></p>
            <p class="hero-lead">关注大语言模型后训练、AI Search 与多智能体协作，把研究里的方法论沉淀为清晰、可复用、能落地的产品能力。</p>
            <div class="hero-signals" aria-label="专业方向">
                <span><strong>LLM</strong> Post-Training</span>
                <span><strong>AI</strong> Search Agents</span>
                <span><strong>MARL</strong> Coordination</span>
            </div>
            <div class="hero-actions">
                <a href="<%- url_for('/archives') %>" class="hero-btn hero-btn-primary">
                    <i class="fas fa-pen-nib" aria-hidden="true"></i> 阅读文章
                </a>
                <a href="<%- url_for('/projects') %>" class="hero-btn hero-btn-ghost">
                    <i class="fas fa-layer-group" aria-hidden="true"></i> 查看作品
                </a>
            </div>
            <div class="hero-socials" aria-label="联系方式">
                <% if (theme.social && theme.social.github) { %>
                <a href="<%= theme.social.github %>" target="_blank" rel="noopener"><i class="fab fa-github" aria-hidden="true"></i> GitHub</a>
                <% } %>
                <% if (theme.social && theme.social.email) { %>
                <a href="mailto:<%= theme.social.email %>"><i class="fas fa-envelope" aria-hidden="true"></i> Email</a>
                <% } %>
            </div>
        </div>
    </div>

    <a href="#recentPosts" class="hero-scroll-indicator" aria-label="查看最近文章">
        <span class="scroll-line"></span>
        <span>Latest</span>
    </a>
</section>

<main class="main-content home-main">
    <section class="section recent-posts" id="recentPosts">
        <div class="section-header">
            <div>
                <p class="section-eyebrow">Writing</p>
                <h2 class="section-title">最近文章</h2>
            </div>
            <% if (site.posts.length) { %>
            <a href="<%- url_for('/archives') %>" class="section-link">全部文章 <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            <% } %>
        </div>
        <% if (site.posts.length) { %>
        <div class="posts-grid">
            <% var posts = site.posts.sort('-date').limit(6); %>
            <% posts.each(function(post, index){ %>
            <a href="<%- url_for(post.path) %>" class="post-card">
                <div class="card-body">
                    <div class="card-meta">
                        <span class="card-date"><i class="far fa-calendar" aria-hidden="true"></i> <%= date(post.date, 'MMM DD, YYYY') %></span>
                        <% if (post.tags && post.tags.length) { %>
                        <span class="card-tag"><%= post.tags.toArray()[0].name %></span>
                        <% } %>
                    </div>
                    <h3 class="card-title"><%= post.title %></h3>
                    <p class="card-excerpt">
                        <%= strip_html(post.content).substring(0, theme.excerpt_length || 150) %>
                    </p>
                    <span class="card-link">阅读全文 <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                </div>
            </a>
            <% }); %>
        </div>
        <% } else { %>
        <div class="empty-state">
            <i class="fas fa-feather-pointed" aria-hidden="true"></i>
            <p>新的内容正在整理中。</p>
        </div>
        <% } %>
    </section>
</main>

<%- partial('_partial/footer') %>

<script>
    (function() {
        const toggle = document.getElementById('heroMobileToggle');
        const navLinks = document.getElementById('heroNavLinks');
        const nav = document.getElementById('heroNav');
        const indicator = document.querySelector('.hero-scroll-indicator');

        function setMenu(open) {
            if (!toggle || !navLinks) return;
            navLinks.classList.toggle('open', open);
            toggle.classList.toggle('active', open);
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        if (toggle && navLinks) {
            toggle.addEventListener('click', function() {
                setMenu(!navLinks.classList.contains('open'));
            });
            navLinks.querySelectorAll('a').forEach(function(link) {
                link.addEventListener('click', function() {
                    setMenu(false);
                });
            });
        }

        function syncHeroState() {
            const scrolled = window.pageYOffset > 72;
            if (nav) nav.classList.toggle('scrolled', scrolled);
            if (indicator) indicator.classList.toggle('is-hidden', window.pageYOffset > 96);
        }

        window.addEventListener('scroll', syncHeroState, { passive: true });
        syncHeroState();
    })();
</script>
