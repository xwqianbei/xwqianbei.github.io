<%
function getPostTag(post) {
    if (post.tags && post.tags.length) {
        return post.tags.toArray()[0].name;
    }
    if (post.categories && post.categories.length) {
        return post.categories.toArray()[0].name;
    }
    return 'Article';
}

var navMeta = {
    '首页': { icon: 'fa-house-chimney', tone: 'Home' },
    '文字': { icon: 'fa-pen-nib', tone: 'Writing' },
    '作品': { icon: 'fa-layer-group', tone: 'Works' },
    '生活': { icon: 'fa-compass', tone: 'Life' },
    '关于': { icon: 'fa-user', tone: 'About' }
};

function getNavMeta(key) {
    return navMeta[key] || { icon: 'fa-circle', tone: key };
}

var lifeHighlights = [
    {
        kind: '旅行',
        icon: 'fa-route',
        date: '2026.05.14 - 05.23',
        title: '云南十日旅行',
        place: '大理 · 丽江 · 香格里拉',
        note: '把雪山、古城、湖风和路上的光线收进同一段旅程里。',
        tags: ['云南', '旅拍', '高原']
    },
    {
        kind: '音乐',
        icon: 'fa-music',
        date: '2025.03.23 - 03.30',
        title: '循环《花田错》',
        place: '一周旋律记忆',
        note: '用一首歌给那段时间做索引，之后再听见时能回到当时的心境。',
        tags: ['华语音乐', '循环播放']
    }
];
%>

<section class="hero-fullscreen" id="heroSection" aria-label="个人主页">
    <div class="hero-bg">
        <div class="hero-bg-image"></div>
        <div class="hero-bg-overlay"></div>
    </div>

    <nav class="hero-nav" id="heroNav">
        <div class="hero-nav-inner">
            <a href="<%- url_for('/') %>" class="hero-brand">
                <img src="<%= theme.avatar || '/images/icons/main.jpg' %>" alt="<%= config.author %>" class="hero-avatar" />
                <span><%= config.author %></span>
            </a>
            <ul class="hero-nav-links" id="heroNavLinks">
                <% var menuKeys = Object.keys(theme.menu); %>
                <% menuKeys.forEach(function(key) { 
                    var target = theme.menu[key];
                    var meta = getNavMeta(key);
                %>
                <li>
                    <a href="<%- url_for(target) %>" class="hero-nav-link<% if (target === '/') { %> active<% } %>"<% if (target === '/') { %> aria-current="page"<% } %>>
                        <i class="fas <%= meta.icon %>" aria-hidden="true"></i>
                        <span class="hero-nav-text"><%= key %></span>
                    </a>
                </li>
                <% }); %>
            </ul>
            <button class="hero-mobile-toggle" id="heroMobileToggle" aria-label="Toggle menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <div class="hero-content">
        <div class="hero-grid">
            <div class="hero-copy">
                <p class="hero-kicker">Xiong Wei · LLM Algorithm Engineer</p>
                <h1 class="hero-title"><%= config.author %></h1>
                <p class="hero-subtitle"><%= config.subtitle %></p>
                <p class="hero-lead">关注大语言模型后训练、AI Search 与多智能体协作，把研究里的方法论沉淀为清晰、可复用、能落地的产品能力。</p>
                <div class="hero-signals" aria-label="专业方向">
                    <span><strong>LLM</strong> Post-Training</span>
                    <span><strong>AI</strong> Search Agents</span>
                    <span><strong>MARL</strong> Coordination</span>
                </div>
                <div class="hero-actions">
                    <a href="<%- url_for('/archives') %>" class="hero-btn hero-btn-primary">
                        <i class="fas fa-pen-nib" aria-hidden="true"></i> 阅读文章
                    </a>
                    <a href="<%- url_for('/projects') %>" class="hero-btn hero-btn-ghost">
                        <i class="fas fa-layer-group" aria-hidden="true"></i> 查看作品
                    </a>
                </div>
                <div class="hero-socials" aria-label="联系方式">
                    <% if (theme.social && theme.social.github) { %>
                    <a href="<%= theme.social.github %>" target="_blank" rel="noopener"><i class="fab fa-github" aria-hidden="true"></i> GitHub</a>
                    <% } %>
                    <% if (theme.social && theme.social.email) { %>
                    <a href="mailto:<%= theme.social.email %>"><i class="fas fa-envelope" aria-hidden="true"></i> Email</a>
                    <% } %>
                </div>
            </div>
            <aside class="hero-aside" aria-label="个人概览">
                <section class="profile-card">
                    <div class="profile-card-top">
                        <img src="<%= theme.avatar || '/images/icons/main.jpg' %>" alt="<%= config.author %>" class="profile-avatar" />
                        <div>
                            <p class="profile-card-kicker">Current mode</p>
                            <p class="profile-card-status">Research, build, write</p>
                        </div>
                    </div>
                    <h2 class="profile-card-title">LLM post-training, AI search, multi-agent coordination</h2>
                    <p class="profile-card-text">把研究里的方法论沉淀成可落地的工程表达，让页面、模型和交互都保持清晰、克制、稳定。</p>
                    <div class="profile-card-tags" aria-label="主页标签">
                        <span>Research</span>
                        <span>Engineering</span>
                        <span>Writing</span>
                    </div>
                </section>
                <div class="hero-metrics">
                    <div class="metric-card">
                        <span class="metric-label">Focus</span>
                        <strong>LLM / Search / MARL</strong>
                    </div>
                    <div class="metric-card">
                        <span class="metric-label">Mode</span>
                        <strong>Research and product thinking</strong>
                    </div>
                    <div class="metric-card">
                        <span class="metric-label">Output</span>
                        <strong>Posts, experiments, and systems</strong>
                    </div>
                </div>
            </aside>
        </div>
    </div>

    <a href="#lifeMoments" class="hero-scroll-indicator" aria-label="查看足迹与兴趣">
        <span class="scroll-line"></span>
        <span>Explore</span>
    </a>
</section>

<main class="main-content home-main">
    <section class="section life-home" id="lifeMoments">
        <div class="section-header section-header-home">
            <div>
                <p class="section-eyebrow">Life ledger</p>
                <h2 class="section-title">足迹与兴趣</h2>
            </div>
            <a href="<%- url_for('/life') %>" class="section-link">进入生活轨迹 <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="life-home-grid">
            <% lifeHighlights.forEach(function(item, index) { %>
            <a href="<%- url_for('/life') %>" class="life-home-card">
                <span class="life-home-index"><%= ('0' + (index + 1)).slice(-2) %></span>
                <span class="life-home-icon"><i class="fas <%= item.icon %>" aria-hidden="true"></i></span>
                <span class="life-home-meta"><%= item.kind %> · <%= item.date %></span>
                <strong><%= item.title %></strong>
                <span class="life-home-place"><%= item.place %></span>
                <span class="life-home-note"><%= item.note %></span>
                <span class="life-home-tags" aria-label="生活标签">
                    <% item.tags.forEach(function(tag) { %>
                    <span><%= tag %></span>
                    <% }); %>
                </span>
            </a>
            <% }); %>
        </div>
    </section>

    <section class="section recent-posts" id="recentPosts">
        <div class="section-header section-header-home">
            <div>
                <p class="section-eyebrow">Selected writing</p>
                <h2 class="section-title">最近文章</h2>
            </div>
            <% if (site.posts.length) { %>
            <a href="<%- url_for('/archives') %>" class="section-link">全部文章 <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            <% } %>
        </div>
        <% if (site.posts.length) { %>
        <% var posts = site.posts.sort('-date').limit(5); %>
        <div class="home-post-layout">
            <% posts.each(function(post, index){ if (index === 0) { 
                var coverImg = post.cover || post.image || '/images/self/life_photo.jpg';
                var primaryTag = getPostTag(post);
            %>
            <a href="<%- url_for(post.path) %>" class="featured-post">
                <div class="featured-post-media">
                    <img src="<%- url_for(coverImg) %>" alt="<%= post.title %>" />
                    <span class="featured-post-badge">Featured</span>
                </div>
                <div class="featured-post-body">
                    <div class="featured-post-meta">
                        <span class="featured-post-date"><i class="far fa-calendar" aria-hidden="true"></i> <%= date(post.date, 'MMM DD, YYYY') %></span>
                        <span class="featured-post-tag"><%= primaryTag %></span>
                    </div>
                    <h3 class="featured-post-title"><%= post.title %></h3>
                    <p class="featured-post-excerpt">
                        <%= strip_html(post.excerpt || post.content).substring(0, theme.excerpt_length || 150) %>
                    </p>
                    <span class="featured-post-link">阅读全文 <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                </div>
            </a>
            <% } }); %>

            <% if (site.posts.length > 1) { %>
            <div class="home-post-stack">
                <% posts.each(function(post, index){ if (index > 0) {
                    var secondaryTag = getPostTag(post);
                %>
                <a href="<%- url_for(post.path) %>" class="compact-post">
                    <span class="compact-post-index"><%= ('0' + (index + 1)).slice(-2) %></span>
                    <div class="compact-post-body">
                        <div class="compact-post-top">
                            <span class="compact-post-date"><i class="far fa-calendar" aria-hidden="true"></i> <%= date(post.date, 'MMM DD, YYYY') %></span>
                            <span class="compact-post-tag"><%= secondaryTag %></span>
                        </div>
                        <h3 class="compact-post-title"><%= post.title %></h3>
                        <p class="compact-post-excerpt">
                            <%= strip_html(post.excerpt || post.content).substring(0, 110) %>
                        </p>
                        <span class="compact-post-link">继续阅读 <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                    </div>
                </a>
                <% } }); %>
            </div>
            <% } %>
        </div>
        <% } else { %>
        <div class="empty-state">
            <i class="fas fa-feather-pointed" aria-hidden="true"></i>
            <p>新的内容正在整理中。</p>
        </div>
        <% } %>
    </section>
</main>

<%- partial('_partial/footer') %>

<script>
    (function() {
        const toggle = document.getElementById('heroMobileToggle');
        const navLinks = document.getElementById('heroNavLinks');
        const nav = document.getElementById('heroNav');
        const indicator = document.querySelector('.hero-scroll-indicator');

        function setMenu(open) {
            if (!toggle || !navLinks) return;
            navLinks.classList.toggle('open', open);
            toggle.classList.toggle('active', open);
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        if (toggle && navLinks) {
            toggle.addEventListener('click', function() {
                setMenu(!navLinks.classList.contains('open'));
            });
            navLinks.querySelectorAll('a').forEach(function(link) {
                link.addEventListener('click', function() {
                    setMenu(false);
                });
            });
        }

        function syncHeroState() {
            const scrolled = window.pageYOffset > 72;
            if (nav) nav.classList.toggle('scrolled', scrolled);
            if (indicator) indicator.classList.toggle('is-hidden', window.pageYOffset > 96);
        }

        window.addEventListener('scroll', syncHeroState, { passive: true });
        syncHeroState();
    })();
</script>
