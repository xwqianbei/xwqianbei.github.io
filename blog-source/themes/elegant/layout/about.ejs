<%
var profile = site.data.profile || {};
var highlights = profile.highlights || [];
var interests = profile.interests || [];
var education = profile.education || [];
var experience = profile.experience || [];
var publications = profile.publications || [];
%>

<article class="about-page">
    <header class="about-hero">
        <div class="about-hero-media">
            <img src="<%- url_for(profile.avatar || theme.avatar || '/images/icons/main.jpg') %>" alt="<%= profile.name || 'Profile' %>" />
        </div>
        <div class="about-hero-copy">
            <p class="page-eyebrow">About</p>
            <h1 class="about-name"><%= profile.name || 'Xiong Wei' %><% if (profile.nameCn) { %> <span><%= profile.nameCn %></span><% } %></h1>
            <p class="about-role"><%= profile.role || 'AI Researcher' %></p>
            <div class="about-contact">
                <% if (profile.email) { %>
                <a href="mailto:<%= profile.email %>"><i class="fas fa-envelope" aria-hidden="true"></i> Email</a>
                <% } %>
                <% if (profile.github) { %>
                <a href="<%= profile.github %>" target="_blank" rel="noopener"><i class="fab fa-github" aria-hidden="true"></i> GitHub</a>
                <% } %>
            </div>
        </div>
        <div class="about-hero-stats" aria-label="Profile highlights">
            <% highlights.forEach(function(item) { %>
            <div>
                <span><%= item.label %></span>
                <strong><%= item.value %></strong>
            </div>
            <% }); %>
        </div>
    </header>

    <section class="about-section">
        <div class="section-heading">
            <p class="page-eyebrow">Research</p>
            <h2 class="about-section-title">Interests</h2>
        </div>
        <div class="interest-tags">
            <% interests.forEach(function(item) { %>
            <span class="interest-tag"><%= item %></span>
            <% }); %>
        </div>
    </section>

    <div class="about-grid">
        <section class="about-section">
            <div class="section-heading">
                <p class="page-eyebrow">Education</p>
                <h2 class="about-section-title">Academic Path</h2>
            </div>

            <div class="timeline">
                <% education.forEach(function(item) { %>
                <div class="timeline-item">
                    <div class="timeline-header">
                        <div class="timeline-info">
                            <h3 class="timeline-title"><%= item.title %></h3>
                            <p class="timeline-subtitle"><%= item.subtitle %></p>
                        </div>
                        <span class="timeline-date"><%= item.date %></span>
                    </div>
                    <p class="timeline-detail"><%= item.detail %></p>
                </div>
                <% }); %>
            </div>
        </section>

        <section class="about-section">
            <div class="section-heading">
                <p class="page-eyebrow">Experience</p>
                <h2 class="about-section-title">Industry Work</h2>
            </div>

            <div class="timeline">
                <% experience.forEach(function(item) { %>
                <div class="timeline-item">
                    <div class="timeline-header">
                        <div class="timeline-info">
                            <h3 class="timeline-title"><%= item.title %></h3>
                            <p class="timeline-subtitle"><%= item.subtitle %></p>
                        </div>
                        <span class="timeline-date"><%= item.date %></span>
                    </div>
                    <p class="timeline-detail"><%= item.detail %></p>
                </div>
                <% }); %>
            </div>
        </section>
    </div>

    <section class="about-section">
        <div class="section-heading">
            <p class="page-eyebrow">Publications</p>
            <h2 class="about-section-title">Selected Papers</h2>
        </div>
        <ul class="publication-list">
            <% publications.forEach(function(item) { %>
            <li class="publication-item">
                <span class="pub-title"><%= item.title %></span>
                <span class="pub-venue"><%= item.venue %></span>
            </li>
            <% }); %>
        </ul>
    </section>
</article>
