: 100%;\n}\n\n.title-input {\n    border: none;\n    font-size: 28px;\n    font-weight: 700;\n    margin-bottom: 30px;\n    color: var(--text-main);\n    font-family: var(--font-serif);\n}\n.title-input::placeholder { color: #CBD5E1; }\n\n.content-textarea {\n    flex: 1;\n    border: none;\n    resize: none;\n    font-size: 16px;\n    line-height: 1.8;\n    color: var(--text-main);\n    font-family: var(--font-serif);\n    min-height: 500px;\n}\n.content-textarea::placeholder { color: #CBD5E1; }\n\n.editor-footer {\n    height: 40px;\n    border-top: 1px solid var(--border-color);\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 0 20px;\n    font-size: 12px;\n    color: var(--text-muted);\n}\n.footer-stats { display: flex; gap: 20px; }\n.footer-tools { display: flex; align-items: center; gap: 15px; }\n\n/* --- Right Sidebar --- */\n.sidebar-right {\n    width: 260px;\n    background: var(--sidebar-bg);\n    border-left: 1px solid var(--border-color);\n    display: flex;\n    flex-direction: column;\n    overflow-y: auto;\n}\n\n.sidebar-header {\n    padding: 20px;\n    display: flex; justify-content: space-between; align-items: center;\n    font-size: 14px; font-weight: 600;\n}\n\n.tool-section { padding: 0 20px 20px; }\n.tool-section h3 {\n    font-size: 12px; color: var(--text-muted); font-weight: 500;\n    margin-bottom: 12px; display: flex; justify-content: space-between;\n}\n\n.icon-grid {\n    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\n}\n.icon-btn-large {\n    background: var(--white); border: 1px solid var(--border-color);\n    border-radius: 8px; height: 50px;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 24px; color: var(--text-main);\n    box-shadow: var(--shadow-sm); transition: all 0.2s;\n}\n.icon-btn-large:hover { background: #F3F4F6; color: var(--primary-color); }\n#publish-btn { background: var(--primary-light); border-color: var(--primary-light); color: var(--primary-color); }\n#publish-btn:hover { background: #C6F6D5; }\n\n.meta-section .input-group { margin-bottom: 15px; }\n.meta-section label { display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 5px; }\n.meta-section input {\n    width: 100%; padding: 8px 10px; border: 1px solid var(--border-color);\n    border-radius: 6px; font-size: 13px;\n}\n\n.stats-section .stat-item {\n    display: flex; justify-content: space-between; padding: 10px 0;\n    border-bottom: 1px solid var(--border-color);\n    font-size: 13px;\n}\n.stats-section .stat-item:last-child { border-bottom: none; }\n.stat-item .label { color: var(--text-muted); }\n.stat-item .value { font-weight: 600; }\n\n/* Toast */\n.toast {\n    position: fixed; top: 20px; left: 50%; transform: translateX(-50%) translateY(-20px);\n    background: var(--text-main); color: var(--white);\n    padding: 10px 20px; border-radius: 8px;\n    font-size: 14px; opacity: 0; pointer-events: none;\n    transition: all 0.3s ease; z-index: 10000;\n}\n.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n.toast.success { background: var(--primary-color); }\n.toast.error { background: #E53E3E; }\n"},{"title":"Projects","layout":"projects","_content":"","source":"projects/index.md","raw":"---\ntitle: Projects\nlayout: projects\n---\n","date":"2026-05-21T06:25:45.928Z","updated":"2026-05-21T06:25:45.928Z","path":"projects/index.html","comments":1,"_id":"cmpf3x9by0005vz0b53l09dmr","content":"","excerpt":"","more":""},{"title":"Tags","layout":"tag","_content":"","source":"tags/index.md","raw":"---\ntitle: Tags\nlayout: tag\n---\n","date":"2026-05-21T06:25:45.928Z","updated":"2026-05-21T06:25:45.928Z","path":"tags/index.html","comments":1,"_id":"cmpf3x9bz0006vz0b25gfeygn","content":"","excerpt":"","more":""}],"Post":[{"title":"测试","date":"2026-05-02T07:26:38.000Z","_content":"\n# Title 1\n这是正文内容","source":"_posts/2026-05-02-测试.md","raw":"---\ntitle: 测试\ndate: 2026-05-02 07:26:38\n---\n\n# Title 1\n这是正